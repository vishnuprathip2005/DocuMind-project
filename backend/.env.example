# Backend Environment Configuration
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/document_ai
# If PostgreSQL is not configured or for quick local development, SQLite fallback is supported:
# DATABASE_URL=sqlite:///./storage/document_ai.db

STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=10
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
